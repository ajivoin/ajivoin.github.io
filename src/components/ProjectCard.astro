---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";

interface Props {
	project: CollectionEntry<"project">;
}

const { project } = Astro.props;
const { title, tech, sourceUrl } = project.data;
const { Content } = await render(project);
---

<article class="border-muted rounded-lg border p-6">
	<div class="mb-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
		<h2 class="title text-accent-2 text-lg font-semibold">{title}</h2>
		{
			sourceUrl && (
				<a class="cactus-link text-sm" href={sourceUrl} rel="noreferrer" target="_blank">
					View source
				</a>
			)
		}
	</div>
	{
		!!tech.length && (
			<ul class="mb-4 flex flex-wrap gap-2" role="list">
				{tech.map((t) => (
					<li class="bg-global-bg text-muted rounded-full border px-2.5 py-0.5 text-xs">{t}</li>
				))}
			</ul>
		)
	}
	<div class="prose prose-sm prose-cactus max-w-none">
		<Content />
	</div>
</article>
